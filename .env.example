# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=book_illustration_studio
DB_USER=root
DB_PASSWORD=

# (Optional) Defaults to backend/storage.
STORAGE_ROOT=

# Gemini
GEMINI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K
GEMINI_CONNECT_TIMEOUT_SECONDS=15
GEMINI_REQUEST_TIMEOUT_SECONDS=180
PIPELINE_EXECUTION_TIMEOUT_SECONDS=600

# Nano Banana image models require Cloud Billing on the same GCP project as
# the API key. Keep mock active while developing to avoid image quota costs.
MOCK_LATENCY_MS=1500

# Pipeline
# Must exceed two sequential Gemini request timeouts; Portraits refreshes its
# project_steps.updated_at heartbeat after each completed portrait.
STEP_STALE_SECONDS=420
